{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/Takenori-Kusaka/jwt-claims-guide/templates/registry/claims.schema.json/v0.2.0",
 "$comment": "template_version: 0.2.0. Registry v1 (#3). Column headings in Japanese, meaning, evidence and the reduced-Lite marker per column are in templates/registry/README.md. Which columns must be filled for which decision beyond the conditions below is rule R1 of claim_lint (tools/claim_lint/RULES.md), so that a missing column is reported with a rule ID.",
 "title": "Claim registry v1",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "scenario",
  "data_category_vocabulary",
  "claims"
 ],
 "properties": {
  "scenario": {
   "type": "string",
   "minLength": 1
  },
  "casestudy_commit": {
   "type": "string",
   "pattern": "^[0-9a-f]{7,40}$"
  },
  "namespaces": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "namespace": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
     },
     "style": {
      "enum": [
       "object",
       "flat_prefix"
      ]
     },
     "owner": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
     },
     "namespace_version": {
      "type": "string",
      "pattern": "^C-[a-z0-9-]+$",
      "description": "Claim that carries the structure version of the namespace object (e.g. C-v)",
      "$comment": "Trace: req:p04-namespace-object-example.R1"
     },
     "assignment": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
     }
    },
    "required": [
     "namespace",
     "style",
     "owner",
     "assignment"
    ],
    "allOf": [
     {
      "if": {
       "properties": {
        "style": {
         "const": "object"
        }
       }
      },
      "then": {
       "required": [
        "namespace_version"
       ]
      }
     }
    ]
   },
   "maxItems": 10,
   "minItems": 1,
   "description": "Namespaces of the organization: how they are carried, who owns them, how names under them are assigned (README#namespace-owner)"
  },
  "data_category_vocabulary": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "name": {
     "const": "fideslang"
    },
    "version": {
     "type": "string",
     "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "url": {
     "type": "string",
     "pattern": "^https://"
    },
    "license": {
     "const": "CC-BY-4.0"
    },
    "verified_on": {
     "type": "string",
     "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
   },
   "required": [
    "name",
    "version",
    "url",
    "license",
    "verified_on"
   ],
   "description": "Pinned external vocabulary of data_category. Referenced, not copied (CC BY 4.0)"
  },
  "data_category_extensions": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
     },
     "parent": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$"
     },
     "description": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
     },
     "owner": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
     }
    },
    "required": [
     "key",
     "parent",
     "description",
     "owner"
    ]
   },
   "maxItems": 50,
   "minItems": 1,
   "description": "Organization sub-categories below a key of the pinned vocabulary (key starts with parent + \".\"; claim_lint checks)"
  },
  "claims": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/claim"
   },
   "maxItems": 500,
   "minItems": 1
  }
 },
 "$defs": {
  "ref": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "kind",
    "id"
   ],
   "properties": {
    "kind": {
     "enum": [
      "spec",
      "guidance",
      "research",
      "book",
      "incident",
      "guide-slide",
      "author-proposal"
     ]
    },
    "id": {
     "type": "string",
     "minLength": 1,
     "pattern": "\\S"
    },
    "url": {
     "type": "string",
     "pattern": "^https?://"
    },
    "verified_on": {
     "type": "string",
     "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "tracking": {
     "type": "string",
     "pattern": "^#\\d+$"
    }
   },
   "allOf": [
    {
     "if": {
      "properties": {
       "kind": {
        "const": "author-proposal"
       }
      }
     },
     "then": {
      "required": [
       "tracking"
      ]
     }
    },
    {
     "$comment": "ASVS belongs in asvs_ids, not in refs (templates/CONTRIBUTING.md 1., casestudy-mapping.md 8.): an id that names ASVS in any spelling or is a bare ASVS requirement number (V8.3.2), or a url of the ASVS project",
     "not": {
      "anyOf": [
       {
        "required": [
         "id"
        ],
        "properties": {
         "id": {
          "pattern": "(?i)ASVS|application\\s+security\\s+verification\\s+standard|^\\s*v\\d+(\\.\\d+){1,3}\\s*$|^\\s*v\\d+\\.\\d+\\.\\d+-"
         }
        }
       },
       {
        "required": [
         "url"
        ],
        "properties": {
         "url": {
          "pattern": "(?i)owasp/asvs|application-security-verification-standard"
         }
        }
       }
      ]
     }
    }
   ]
  },
  "claim": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^C-[a-z0-9-]+$"
    },
    "name": {
     "type": "string",
     "minLength": 1,
     "description": "Claim name as it appears in the JSON object, without the namespace. A value taken from the access context names the moment it was taken (e.g. auth_ip, not ip) and says in not_meaning what it does not mean"
    },
    "namespace": {
     "type": [
      "string",
      "null"
     ],
     "description": "Namespace the claim sits in, or null for a top-level claim. How the namespace is carried (one object or a flat prefix) is declared once in the top-level namespaces[].style",
     "$comment": "Trace: req:p04-namespace.R1"
    },
    "catalog_refs": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^jwt-claims-casestudy@[0-9a-f]{7,40}:(CLM-\\d{4}|ORG-\\d{2}|HDR-\\d{2})$"
     },
     "maxItems": 10,
     "uniqueItems": true,
     "description": "Rows of the casestudy claim list (name and type are owned there; tools/casestudy_check.py compares the ORG rows). A list, because the list has one row per defining source"
    },
    "catalog_refs_reason": {
     "type": "string",
     "minLength": 1,
     "pattern": "\\S",
     "description": "Why a row has no row in the casestudy claim list (catalog_refs: [])"
    },
    "registered_ref": {
     "$ref": "#/$defs/ref"
    },
    "type": {
     "enum": [
      "string",
      "number",
      "integer",
      "boolean",
      "object"
     ],
     "description": "JSON type of one value (of each element when shape is array). Exactly one type",
     "$comment": "Trace: req:p00-claims-are-contracts.R3 req:p00-why-hard.R1 req:p11-registry-fields.R2"
    },
    "shape": {
     "enum": [
      "single",
      "array",
      "space_delimited"
     ],
     "description": "single value, JSON array, or one string of space-delimited values (scope). Declared so that consumers do not read the form differently",
     "$comment": "Trace: req:p00-claims-are-contracts.R3 req:p00-why-hard.R1 req:p00-why-hard.R3 req:p02-scope.R7 req:p11-registry-fields.R2"
    },
    "allowed_values": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "pattern": {
       "type": "string",
       "minLength": 1,
       "pattern": "\\S"
      },
      "enum": {
       "type": "array",
       "items": {
        "type": [
         "string",
         "number",
         "integer",
         "boolean"
        ]
       },
       "maxItems": 100,
       "minItems": 1,
       "uniqueItems": true
      },
      "min": {
       "type": "number"
      },
      "max": {
       "type": "number"
      },
      "format": {
       "enum": [
        "uri",
        "uuid",
        "date-time",
        "email",
        "numeric-date"
       ]
      }
     },
     "minProperties": 1,
     "description": "Format (regular expression) and permitted values of one value",
     "$comment": "Trace: req:p11-registry-fields.R2"
    },
    "value_vocabulary": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "values": {
       "type": "array",
       "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
       },
       "maxItems": 200,
       "minItems": 1,
       "uniqueItems": true
      },
      "namespace": {
       "type": "string",
       "minLength": 1,
       "pattern": "\\S"
      },
      "owner": {
       "type": "string",
       "minLength": 1,
       "pattern": "\\S"
      },
      "extensible": {
       "type": "boolean"
      }
     },
     "required": [
      "values",
      "owner"
     ],
     "description": "Vocabulary of values owned by the organization (roles, groups, acr values, authorization_details types)",
     "$comment": "Trace: req:p02-roles-groups-entitlements.R2"
    },
    "description": {
     "type": "string",
     "minLength": 1,
     "pattern": "\\S",
     "$comment": "Trace: req:p00-claims-are-contracts.R4 req:p02-check-before-creating.R2 req:p11-registry-fields.R3"
    },
    "not_meaning": {
     "type": "string",
     "minLength": 1,
     "pattern": "\\S",
     "description": "What the claim does not mean (e.g. azp is not client_id; email_verified is not identity proofing)",
     "$comment": "Trace: req:p00-claims-are-contracts.R4 req:p02-check-before-creating.R2 req:p11-registry-fields.R3"
    },
    "absent_semantics": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "absent": {
       "type": "string",
       "minLength": 1,
       "pattern": "\\S"
      },
      "null": {
       "type": "string",
       "minLength": 1,
       "pattern": "\\S"
      },
      "false": {
       "type": "string",
       "minLength": 1,
       "pattern": "\\S"
      },
      "empty_array": {
       "type": "string",
       "minLength": 1,
       "pattern": "\\S"
      },
      "empty_string": {
       "type": "string",
       "minLength": 1,
       "pattern": "\\S"
      }
     },
     "minProperties": 1,
     "description": "Meaning of a missing claim, null, false, an empty array and an empty string. A claim that can disappear at a limit (Entra groups overage) is never read as \"no membership\"",
     "$comment": "Trace: req:p00-claims-are-contracts.R3 req:p00-why-hard.R1 req:p00-why-hard.R5 req:p04-absent-null-false-empty.R1"
    },
    "flat_alias": {
     "type": "string",
     "minLength": 1,
     "pattern": "\\S",
     "description": "Flat name with the same content, for IdPs that cannot nest (e.g. https://claims.example.com/tenant_id)"
    },
    "paired_id": {
     "type": "string",
     "pattern": "^C-[a-z0-9-]+$",
     "description": "For a name claim: the claim of the immutable ID that is issued with it and used for matching",
     "$comment": "Trace: req:p00-incident-signature-valid.R4 req:p04-immutable-identifiers.R2"
    },
    "composite_format": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "components": {
       "type": "array",
       "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
       },
       "maxItems": 10,
       "minItems": 2
      },
      "separator": {
       "type": "string",
       "minLength": 1,
       "pattern": "\\S"
      },
      "escape": {
       "type": "string",
       "minLength": 1,
       "pattern": "\\S"
      },
      "published_at": {
       "type": "string",
       "minLength": 1,
       "pattern": "\\S"
      }
     },
     "required": [
      "components",
      "separator",
      "escape"
     ],
     "description": "For a composite identifier: its parts, the separator and how the separator is escaped. Decided and published by the issuer",
     "$comment": "Trace: req:p00-incident-signature-valid.R4 req:p04-immutable-identifiers.R3"
    },
    "value_normalization": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "case": {
       "enum": [
        "as_is",
        "lower",
        "upper"
       ]
      },
      "unicode": {
       "enum": [
        "none",
        "NFC",
        "NFKC"
       ]
      },
      "trim": {
       "type": "boolean"
      },
      "compare": {
       "enum": [
        "exact",
        "case_insensitive"
       ]
      },
      "normalized_by": {
       "type": "string",
       "minLength": 1,
       "pattern": "\\S"
      }
     },
     "required": [
      "case",
      "compare",
      "normalized_by"
     ],
     "description": "Normalization of the value, done once by the writer (normalized_by), and how consumers compare",
     "$comment": "Trace: req:p04-case-and-characters.R2"
    },
    "prior_art_search": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "searched": {
       "type": "array",
       "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
       },
       "maxItems": 20,
       "minItems": 1
      },
      "nearest": {
       "type": "array",
       "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
       },
       "maxItems": 20
      },
      "not_used_because": {
       "type": "string",
       "minLength": 1,
       "pattern": "\\S"
      }
     },
     "required": [
      "searched",
      "not_used_because"
     ],
     "description": "Where the author looked before creating the claim (IANA, specs, IdP documents) and why the nearest existing claim is not used",
     "$comment": "Trace: req:p02-check-before-creating.R3"
    },
    "path": {
     "type": "array",
     "items": {
      "type": [
       "string",
       "integer",
       "null"
      ]
     },
     "maxItems": 10,
     "minItems": 1,
     "description": "SD-JWT VC claim metadata path (draft-ietf-oauth-sd-jwt-vc-27 §5.6): the claim path in the credential. Same name and meaning"
    },
    "mandatory": {
     "type": "boolean",
     "description": "SD-JWT VC claim metadata mandatory (§5.6). Default false. Same name and meaning"
    },
    "sd": {
     "enum": [
      "always",
      "allowed",
      "never"
     ],
     "description": "SD-JWT VC claim metadata sd (§5.6). Default allowed. Same name and meaning"
    },
    "display": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
       "locale": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
       },
       "label": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
       },
       "description": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
       },
       "dir": {
        "enum": [
         "ltr",
         "rtl",
         "auto"
        ]
       }
      },
      "required": [
       "locale",
       "label"
      ]
     },
     "maxItems": 20,
     "minItems": 1,
     "description": "SD-JWT VC claim metadata display (§5.6.2): label per locale; dir is ltr, rtl or auto (default auto, §5.5). Same name and meaning"
    },
    "decision": {
     "enum": [
      "採用",
      "却下",
      "既定どおり"
     ]
    },
    "rejection_kind": {
     "enum": [
      "代替あり",
      "不要",
      "禁止",
      "IdP が出さない"
     ],
     "description": "For 却下: the kind of rejection (casestudy judgements 不採用・代替あり／不要／禁止, plus IdP が出さない from v0-columns.md 1. #14)"
    },
    "alt": {
     "type": "array",
     "items": {
      "anyOf": [
       {
        "type": "string",
        "pattern": "^C-[a-z0-9-]+$"
       },
       {
        "type": "string",
        "pattern": "^jwt-claims-casestudy@[0-9a-f]{7,40}:(CLM-\\d{4}|ORG-\\d{2}|HDR-\\d{2})$"
       }
      ]
     },
     "maxItems": 10,
     "minItems": 1,
     "uniqueItems": true,
     "description": "For 却下・代替あり: the claim used instead (registry row or casestudy row)"
    },
    "rationale": {
     "type": "string",
     "minLength": 1,
     "pattern": "\\S"
    },
    "assumption": {
     "type": "string",
     "minLength": 1,
     "pattern": "\\S"
    },
    "revisit_trigger": {
     "type": "string",
     "minLength": 1,
     "pattern": "\\S"
    },
    "refs": {
     "type": "array",
     "minItems": 1,
     "maxItems": 20,
     "items": {
      "$ref": "#/$defs/ref"
     }
    },
    "answers": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^q-[a-z0-9-]+$"
     },
     "maxItems": 20,
     "minItems": 1,
     "uniqueItems": true,
     "description": "IDs of questions.yaml the claim answers"
    },
    "does_not_answer": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^q-[a-z0-9-]+$"
     },
     "maxItems": 20,
     "minItems": 1,
     "uniqueItems": true,
     "description": "IDs of questions.yaml the claim must not be used to answer (e.g. nested act for the current actor)"
    },
    "usage": {
     "enum": [
      "identifier",
      "authz",
      "display",
      "protocol"
     ],
     "description": "identifier: matches a subject or object; authz: decides access; display: shown only; protocol: protocol mechanics (exp, jti, nonce ...). A name is display only; matching uses the paired immutable ID",
     "$comment": "Trace: req:p04-immutable-identifiers.R2"
    },
    "issuers": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
     },
     "maxItems": 50,
     "minItems": 1,
     "uniqueItems": true,
     "description": "iss values allowed to put this claim. Consumers trust the claim only from these",
     "$comment": "Trace: req:p11-registry-fields.R4"
    },
    "upstream_issuer": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "iss": {
       "type": "array",
       "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
       },
       "maxItems": 20,
       "minItems": 1,
       "uniqueItems": true
      },
      "source_attribute": {
       "type": "string",
       "minLength": 1,
       "pattern": "\\S"
      },
      "normalization": {
       "type": "string",
       "minLength": 1,
       "pattern": "\\S"
      }
     },
     "required": [
      "iss",
      "normalization"
     ],
     "description": "When the claim relays a value from an upstream issuer (broker, SAML, another IdP, declarative mapping): the upstream iss and the normalization rule to the organization key",
     "$comment": "Trace: req:p02-saml-attributes.R1 req:p03-absorb-idp-differences.R2 req:p11-translation-layer.R4"
    },
    "authoritative_writer": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
       "stage": {
        "enum": [
         "①",
         "②",
         "③",
         "④",
         "⑤",
         "⑥"
        ],
        "description": "Stage of slide:p06-stage-map (① authentication .. ⑥ approval and consent) at which the claim is written",
        "$comment": "Trace: req:p06-stage-map.R1"
       },
       "writer": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
       },
       "configurable_by": {
        "type": "array",
        "minItems": 1,
        "maxItems": 5,
        "uniqueItems": true,
        "items": {
         "enum": [
          "platform",
          "tenant_admin",
          "end_user",
          "client",
          "caller"
         ]
        },
        "description": "Who can change the setting that decides the value (A01 of research/template-design/gate1.md 5.)"
       }
      },
      "required": [
       "stage",
       "writer"
      ]
     },
     "maxItems": 6,
     "minItems": 1,
     "description": "The one authoritative writer per stage (L4 of #6 checks uniqueness), and who can change its setting",
     "$comment": "Trace: req:p04-case-and-characters.R2 req:p11-registry-fields.R5"
    },
    "modifiers": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
       "stage": {
        "enum": [
         "①",
         "②",
         "③",
         "④",
         "⑤",
         "⑥"
        ]
       },
       "writer": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
       },
       "action": {
        "enum": [
         "追加",
         "抑止",
         "上書き"
        ]
       },
       "configurable_by": {
        "type": "array",
        "minItems": 1,
        "maxItems": 5,
        "uniqueItems": true,
        "items": {
         "enum": [
          "platform",
          "tenant_admin",
          "end_user",
          "client",
          "caller"
         ]
        },
        "description": "Who can change the setting that decides the value (A01 of research/template-design/gate1.md 5.)"
       }
      },
      "required": [
       "stage",
       "writer",
       "action"
      ]
     },
     "maxItems": 10,
     "minItems": 1,
     "description": "Writers that add, suppress or overwrite the value after the authoritative writer (hooks, gateways)"
    },
    "provenance": {
     "enum": [
      "発行者が確かめた値",
      "管理者が設定した値",
      "本人が編集できる値",
      "呼び出し側の申告"
     ],
     "description": "Where the value comes from and who can write it. Values of different provenance get different names",
     "$comment": "Trace: req:p04-split-by-writer.R1 req:p11-registry-fields.R5"
    },
    "issue_events": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^I\\d{2}$"
     },
     "maxItems": 40,
     "uniqueItems": true,
     "description": "Issue events of templates/catalog/issue_events.yaml that put the claim"
    },
    "source_system": {
     "type": "string",
     "minLength": 1,
     "pattern": "\\S",
     "description": "Authoritative source of the value (owned by the department responsible for its meaning)",
     "$comment": "Trace: req:p11-registry-fields.R10"
    },
    "verification_method": {
     "type": "string",
     "minLength": 1,
     "pattern": "\\S",
     "description": "How the source value is checked (e.g. organization membership from the HR system, not from the e-mail domain)"
    },
    "last_verified": {
     "type": "string",
     "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "source_max_length": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "value": {
       "type": "integer",
       "minimum": 1
      },
      "unit": {
       "enum": [
        "bytes",
        "utf16_code_units",
        "code_points",
        "unknown"
       ]
      },
      "basis": {
       "type": "string",
       "minLength": 1,
       "pattern": "\\S"
      }
     },
     "required": [
      "value",
      "unit",
      "basis"
     ],
     "description": "Length limit of the source field with its unit, to check max_bytes (A11 of gate1.md 5.)"
    },
    "volatility": {
     "type": "integer",
     "minimum": 0,
     "description": "Seconds allowed between a change of the value and its reflection. 0: never changes for the subject. Compared with max_lifetime of the carrying token types (L5 of #6)",
     "$comment": "Trace: req:p11-registry-fields.R10"
    },
    "recompute_trigger": {
     "type": "array",
     "items": {
      "enum": [
       "login",
       "refresh",
       "exchange",
       "reissue",
       "never"
      ]
     },
     "maxItems": 5,
     "minItems": 1,
     "uniqueItems": true,
     "description": "When the issuer recomputes the value. Authentication claims (acr, auth_time) keep the login value on refresh",
     "$comment": "Trace: req:p02-auth-strength-session.R4 req:p08-stale-claims.R4"
    },
    "propagation_delay": {
     "type": "integer",
     "minimum": 0,
     "description": "Worst-case seconds until a change reaches the consumers (up to the next recompute_trigger, bounded by the token lifetime when only exp ends it)",
     "$comment": "Trace: req:p08-stale-claims.R4 req:p11-registry-fields.R10"
    },
    "on_revoke": {
     "type": "string",
     "minLength": 1,
     "pattern": "\\S"
    },
    "carried_in": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9_-]*$"
     },
     "maxItems": 20,
     "uniqueItems": true,
     "description": "IDs of token_types.yaml that carry the claim (an introspection response is a token type of its own); the hops are in hops.yaml"
    },
    "consumers": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
     },
     "maxItems": 50,
     "uniqueItems": true,
     "description": "Services allowed to read the claim (the contract; [] when nobody reads it)",
     "$comment": "Trace: req:p00-claims-are-contracts.R6 req:p11-registry-fields.R6"
    },
    "consumer_access_path": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
       "consumer": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
       },
       "via": {
        "enum": [
         "token_library",
         "gateway_header",
         "mesh_policy",
         "cel",
         "jsonpath",
         "sdk",
         "other"
        ]
       },
       "note": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
       }
      },
      "required": [
       "consumer",
       "via"
      ]
     },
     "maxItems": 50,
     "minItems": 1
    },
    "consumers_migration": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
       "consumer": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
       },
       "from": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
       },
       "to": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
       },
       "state": {
        "enum": [
         "未着手",
         "移行中",
         "完了"
        ]
       },
       "due": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
       }
      },
      "required": [
       "consumer",
       "state"
      ]
     },
     "maxItems": 50,
     "minItems": 1,
     "description": "Per-consumer state of a migration to a new form",
     "$comment": "Trace: req:p11-change-procedure.R6"
    },
    "on_missing": {
     "enum": [
      "拒否",
      "既定値",
      "無視"
     ],
     "description": "What the consumer does when the claim is missing (details in absent_semantics)",
     "$comment": "Trace: req:p00-why-hard.R5 req:p04-absent-null-false-empty.R1"
    },
    "enforced_at": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
       "service": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
       },
       "check": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
       }
      },
      "required": [
       "service",
       "check"
      ]
     },
     "maxItems": 30
    },
    "max_bytes": {
     "type": "integer",
     "minimum": 0,
     "description": "Worst-case UTF-8 bytes of one value as serialized in JSON, without the quotes of a string (after JSON escaping)",
     "$comment": "Trace: req:p04-carry-or-query.R3 req:p04-size-budget.R1 req:p11-registry-fields.R7"
    },
    "max_items": {
     "type": "integer",
     "minimum": 1,
     "description": "Worst-case number of elements when shape is array",
     "$comment": "Trace: req:p02-roles-groups-entitlements.R4 req:p04-carry-or-query.R3 req:p04-size-budget.R1 req:p11-registry-fields.R7"
    },
    "typical_items": {
     "type": "integer",
     "minimum": 0
    },
    "overflow_strategy": {
     "enum": [
      "発行を失敗させる",
      "問い合わせに切り替える",
      "上限で固定（超えない値域）"
     ],
     "not": {
      "enum": [
       "truncate",
       "切り詰め",
       "切り捨て"
      ]
     },
     "description": "What happens above max_bytes / max_items. Truncation is not a value (no silent loss)",
     "$comment": "Trace: req:p02-roles-groups-entitlements.R4 req:p04-size-budget.R2 req:p06-edge-exchange.R3 req:p11-registry-fields.R7"
    },
    "confidential_from": {
     "type": "array",
     "items": {
      "anyOf": [
       {
        "enum": [
         "browser",
         "client",
         "bff",
         "gateway",
         "idp",
         "api",
         "db",
         "logs",
         "analytics",
         "external_rp",
         "broker"
        ]
       },
       {
        "type": "string",
        "pattern": "^hop:[a-z0-9][a-z0-9._-]*$"
       }
      ]
     },
     "maxItems": 15,
     "uniqueItems": true,
     "description": "Readers that must not read the value ([] = integrity protection is enough). Compared with visible_to of the carrying token types (L65 of #6)"
    },
    "confidentiality_measure": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "outcome": {
       "enum": [
        "載せない",
        "派生値",
        "参照",
        "JWE"
       ]
      },
      "rationale": {
       "type": "string",
       "minLength": 1,
       "pattern": "\\S"
      }
     },
     "required": [
      "outcome",
      "rationale"
     ],
     "description": "Where the claim ended in the order of slide:p09-jwe-sd-jwt (do not carry -> derived value -> reference -> JWE)"
    },
    "integrity_until": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
       "place": {
        "enum": [
         "http_header",
         "db_session",
         "queue_message",
         "log",
         "cache",
         "other"
        ]
       },
       "target": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
       },
       "trust_boundary": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
       }
      },
      "required": [
       "place",
       "target",
       "trust_boundary"
      ]
     },
     "maxItems": 10,
     "description": "Where the value is copied out of the signed token (the JWS no longer protects it there) and the trust boundary that protects the copy"
    },
    "pii_category": {
     "enum": [
      "個人情報",
      "要配慮個人情報",
      "個人関連情報",
      "仮名加工情報",
      "該当なし"
     ],
     "description": "Category under the Act on the Protection of Personal Information (a separate axis from data_category)",
     "$comment": "Trace: req:p09-jws-is-readable.R2 req:p11-registry-fields.R8"
    },
    "data_category": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$"
     },
     "maxItems": 5,
     "minItems": 1,
     "uniqueItems": true,
     "description": "What the data is, as keys of the pinned external vocabulary (top-level data_category_vocabulary, fideslang) or of data_category_extensions. Only the format is validated here; the vocabulary is not copied into templates/ (CC BY 4.0)"
    },
    "identifier_properties": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "stable": {
       "type": "boolean"
      },
      "reassignable": {
       "type": "boolean"
      },
      "pairwise": {
       "type": "boolean"
      },
      "id_scheme": {
       "enum": [
        "opaque",
        "uuid",
        "url",
        "pairwise",
        "email",
        "phone",
        "username",
        "employee_number",
        "composite",
        "other"
       ]
      }
     },
     "required": [
      "stable",
      "reassignable",
      "pairwise",
      "id_scheme"
     ],
     "description": "Properties of an identifier (input of L3, L52 of #6). Separate from volatility"
    },
    "recipients_external": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
       "recipient": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
       },
       "purpose": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
       }
      },
      "required": [
       "recipient",
       "purpose"
      ]
     },
     "maxItems": 20
    },
    "cross_border": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "transfers": {
       "type": "boolean"
      },
      "countries": {
       "type": "array",
       "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
       },
       "maxItems": 50,
       "minItems": 1,
       "uniqueItems": true
      },
      "basis": {
       "type": "string",
       "minLength": 1,
       "pattern": "\\S"
      }
     },
     "required": [
      "transfers"
     ]
    },
    "log_policy": {
     "enum": [
      "記録する",
      "ハッシュ化して記録",
      "記録しない"
     ],
     "$comment": "Trace: req:p11-registry-fields.R8"
    },
    "status": {
     "enum": [
      "proposed",
      "active",
      "deprecated",
      "sunset"
     ],
     "description": "Lifetime of the definition (slide:p11-change-procedure). The change history is the Git history of the file",
     "$comment": "Trace: req:p11-registry-fields.R11"
    },
    "sunset_on": {
     "type": "string",
     "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "owner": {
     "type": "string",
     "minLength": 1,
     "pattern": "\\S",
     "description": "Department responsible for meaning, value and freshness (the authoritative source)",
     "$comment": "Trace: req:p00-claims-are-contracts.R6 req:p11-registry-fields.R9"
    },
    "change_controller": {
     "type": "string",
     "minLength": 1,
     "pattern": "\\S",
     "description": "Who decides changes of the definition: the spec body for registered claims, the registry owner (README#namespace-owner) for organization claims",
     "$comment": "Trace: req:p00-claims-are-contracts.R6 req:p11-ownership.R1"
    },
    "evidence": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 1
     },
     "maxItems": 30,
     "uniqueItems": true,
     "description": "Verification records: jwt-claims-casestudy@<commit>:<case>, tests, configs"
    },
    "asvs_ids": {
     "type": "array",
     "maxItems": 20,
     "uniqueItems": true,
     "items": {
      "type": "string",
      "pattern": "^v\\d+\\.\\d+\\.\\d+-\\d+\\.\\d+\\.\\d+$"
     },
     "description": "OWASP ASVS requirement IDs with the version, e.g. v5.0.0-8.3.2. The only place for ASVS"
    },
    "spec_version": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
     },
     "maxItems": 10,
     "minItems": 1,
     "uniqueItems": true,
     "description": "Versions of drafts the row depends on (e.g. draft-ietf-oauth-transaction-tokens-11)"
    },
    "note": {
     "type": "string"
    }
   },
   "required": [
    "id",
    "name",
    "decision"
   ],
   "allOf": [
    {
     "$comment": "採用 (deviation from the default) and 却下 need two of refs, assumption, revisit_trigger (#3)",
     "if": {
      "properties": {
       "decision": {
        "enum": [
         "採用",
         "却下"
        ]
       }
      },
      "required": [
       "decision"
      ]
     },
     "then": {
      "anyOf": [
       {
        "required": [
         "refs",
         "assumption"
        ]
       },
       {
        "required": [
         "refs",
         "revisit_trigger"
        ]
       },
       {
        "required": [
         "assumption",
         "revisit_trigger"
        ]
       }
      ]
     }
    },
    {
     "if": {
      "properties": {
       "decision": {
        "const": "却下"
       }
      },
      "required": [
       "decision"
      ]
     },
     "then": {
      "required": [
       "rejection_kind"
      ]
     },
     "else": {
      "not": {
       "required": [
        "rejection_kind"
       ]
      }
     }
    },
    {
     "$comment": "A multi-valued claim (JSON array or space-delimited string) has an upper bound on the number of values",
     "if": {
      "properties": {
       "shape": {
        "enum": [
         "array",
         "space_delimited"
        ]
       },
       "decision": {
        "enum": [
         "採用",
         "既定どおり"
        ]
       }
      },
      "required": [
       "shape",
       "decision"
      ]
     },
     "then": {
      "required": [
       "max_items"
      ]
     }
    },
    {
     "if": {
      "properties": {
       "usage": {
        "const": "identifier"
       },
       "decision": {
        "enum": [
         "採用",
         "既定どおり"
        ]
       }
      },
      "required": [
       "usage",
       "decision"
      ]
     },
     "then": {
      "required": [
       "identifier_properties"
      ]
     }
    },
    {
     "if": {
      "properties": {
       "confidential_from": {
        "minItems": 1
       }
      },
      "required": [
       "confidential_from"
      ]
     },
     "then": {
      "required": [
       "confidentiality_measure"
      ]
     },
     "else": {
      "not": {
       "required": [
        "confidentiality_measure"
       ]
      }
     }
    },
    {
     "$comment": "catalog_refs: [] needs a reason (tools/casestudy_check.py requires every row of an example to declare catalog_refs)",
     "if": {
      "properties": {
       "catalog_refs": {
        "maxItems": 0
       }
      },
      "required": [
       "catalog_refs"
      ]
     },
     "then": {
      "required": [
       "catalog_refs_reason"
      ]
     }
    }
   ]
  }
 }
}
