{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/Takenori-Kusaka/jwt-claims-guide/payload-schemas/scenario-b/ENTRA_AT.issuer.schema.json/v0.2.0",
 "$comment": "template_version: 0.2.0. Generated by `python tools/claim_lint render` (#19) from the registry of this design; do not edit. Token type ENTRA_AT (access_token), issuer schema.",
 "title": "ENTRA_AT payload (issuer conformance: registry claims only)",
 "type": "object",
 "properties": {
  "iss": {
   "description": "トークンの発行者",
   "$comment": "C-iss",
   "type": "string",
   "maxLength": 96,
   "format": "uri"
  },
  "sub": {
   "description": "発行者の中で利用者を一意に表す識別子",
   "$comment": "C-sub-unread",
   "type": "string",
   "maxLength": 256
  },
  "aud": {
   "description": "トークンの宛先",
   "$comment": "C-aud",
   "type": "array",
   "items": {
    "type": "string",
    "maxLength": 64,
    "enum": [
     "api://orders",
     "api://invoices"
    ]
   },
   "maxItems": 2
  },
  "exp": {
   "description": "トークンの有効期限（NumericDate）",
   "$comment": "C-exp",
   "type": "integer"
  },
  "iat": {
   "description": "トークンの発行時刻（NumericDate）",
   "$comment": "C-iat",
   "type": "integer"
  },
  "groups": {
   "description": "利用者が属する IdP のグループ（Entra はグループの ID、Okta はグループの名前）",
   "$comment": "C-groups",
   "type": "array",
   "items": {
    "type": "string",
    "maxLength": 64
   },
   "maxItems": 200
  }
 },
 "required": [
  "iss",
  "aud",
  "exp",
  "iat"
 ],
 "additionalProperties": false
}
