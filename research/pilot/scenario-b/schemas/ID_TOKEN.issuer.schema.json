{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/Takenori-Kusaka/jwt-claims-guide/payload-schemas/scenario-b/ID_TOKEN.issuer.schema.json/v0.2.0",
 "$comment": "template_version: 0.2.0. Generated by `python tools/claim_lint render` (#19) from the registry of this design; do not edit. Token type ID_TOKEN (id_token), issuer schema.",
 "title": "ID_TOKEN payload (issuer conformance: registry claims only)",
 "type": "object",
 "properties": {
  "iss": {
   "description": "トークンの発行者",
   "$comment": "C-iss",
   "type": "string",
   "maxLength": 96,
   "format": "uri"
  },
  "sub": {
   "description": "発行者の中で利用者を一意に表す識別子",
   "$comment": "C-sub",
   "type": "string",
   "maxLength": 64
  },
  "aud": {
   "description": "トークンの宛先",
   "$comment": "C-aud",
   "type": "array",
   "items": {
    "type": "string",
    "maxLength": 64,
    "enum": [
     "portal",
     "client-app"
    ]
   },
   "maxItems": 2
  },
  "exp": {
   "description": "トークンの有効期限（NumericDate）",
   "$comment": "C-exp",
   "type": "integer"
  },
  "iat": {
   "description": "トークンの発行時刻（NumericDate）",
   "$comment": "C-iat",
   "type": "integer"
  },
  "nonce": {
   "description": "認証要求と ID トークンを結びつける値",
   "$comment": "C-nonce",
   "type": "string",
   "maxLength": 64
  }
 },
 "required": [
  "iss",
  "sub",
  "aud",
  "exp",
  "iat",
  "nonce"
 ],
 "additionalProperties": false
}
