{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/Takenori-Kusaka/jwt-claims-guide/payload-schemas/scenario-b/AUTH0_AT.issuer.schema.json/v0.2.0",
 "$comment": "template_version: 0.2.0. Generated by `python tools/claim_lint render` (#19) from the registry of this design; do not edit. Token type AUTH0_AT (access_token), issuer schema.",
 "title": "AUTH0_AT payload (issuer conformance: registry claims only)",
 "type": "object",
 "properties": {
  "iss": {
   "description": "トークンの発行者",
   "$comment": "C-iss",
   "type": "string",
   "maxLength": 96,
   "format": "uri"
  },
  "sub": {
   "description": "発行者の中で利用者を一意に表す識別子",
   "$comment": "C-sub",
   "type": "string",
   "maxLength": 64
  },
  "aud": {
   "description": "トークンの宛先",
   "$comment": "C-aud",
   "type": "array",
   "items": {
    "type": "string",
    "maxLength": 64,
    "enum": [
     "https://api.example.com"
    ]
   },
   "maxItems": 2
  },
  "exp": {
   "description": "トークンの有効期限（NumericDate）",
   "$comment": "C-exp",
   "type": "integer"
  },
  "iat": {
   "description": "トークンの発行時刻（NumericDate）",
   "$comment": "C-iat",
   "type": "integer"
  },
  "jti": {
   "description": "トークンの一意の識別子",
   "$comment": "C-jti",
   "type": "string",
   "maxLength": 64
  },
  "client_id": {
   "description": "トークンを求めたクライアント（Cognito・Auth0 の AT）",
   "$comment": "C-client-id",
   "type": "string",
   "maxLength": 64
  },
  "scope": {
   "description": "クライアントに許された権限の範囲（空白区切り）",
   "$comment": "C-scope",
   "type": "string",
   "maxLength": 512
  },
  "https://claims.example.com/roles": {
   "description": "Auth0 の Action が組織の名前空間に書く、利用者の Auth0 のロール",
   "$comment": "C-auth0-roles",
   "type": "array",
   "items": {
    "type": "string",
    "maxLength": 32,
    "enum": [
     "admins",
     "editor",
     "viewer",
     "approver"
    ]
   },
   "maxItems": 20
  }
 },
 "required": [
  "iss",
  "sub",
  "aud",
  "exp",
  "iat",
  "jti",
  "client_id"
 ],
 "additionalProperties": false
}
